{
  "$schema": "https://shadcn-vue.com/schema/registry.json",
  "name": "elf",
  "homepage": "https://xouyi.github.io/elfUI/",
  "items": [
    {
      "name": "utils",
      "type": "registry:lib",
      "title": "cn utility",
      "description": "clsx + tailwind-merge class helper.",
      "dependencies": [
        "clsx",
        "tailwind-merge"
      ],
      "files": [
        {
          "path": "registry/_generated/lib/utils.ts",
          "type": "registry:lib",
          "target": "lib/utils.ts"
        }
      ]
    },
