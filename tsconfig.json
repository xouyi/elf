{
  "compilerOptions": {
    "target": "ESNext",
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "strict": true,
    "jsx": "preserve",
    "skipLibCheck": true,
    "noEmit": true,
    "isolatedModules": true,
    "verbatimModuleSyntax": true,
    "resolveJsonModule": true,
    "types": ["node", "bun", "vite/client"],
    "paths": { "@elf/ui": ["./src/index.ts"] },
    "lib": ["ESNext", "DOM", "DOM.Iterable"]
  },
  "include": ["src/**/*.ts", "src/**/*.vue", "scripts/**/*.ts", "apps/docs/scripts/**/*.ts", "tests/**/*.ts", "vitest.config.ts", "playwright.config.ts"]
}
