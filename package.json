{
  "name": "@elf/ui",
  "version": "0.2.0",
  "description": "ElfUI: a Vue 3 / Nuxt 4 design system built on Reka UI and Tailwind CSS v4.",
  "license": "MIT",
  "type": "module",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/xouyi/elfUI.git"
  },
  "sideEffects": [
    "*.css"
  ],
  "files": [
    "src",
    "!src/**/examples",
    "!src/**/*.test.ts",
    "README.md",
    "LICENSE",
    "CHANGELOG.md"
  ],
  "exports": {
    ".": {
      "types": "./src/index.ts",
      "default": "./src/index.ts"
    },
    "./nuxt": {
      "types": "./src/nuxt/module.ts",
      "default": "./src/nuxt/module.ts"
    },
    "./styles.css": "./src/styles.css",
    "./themes/*.css": "./src/themes/*.css",
    "./lib/utils": "./src/lib/utils.ts",
    "./package.json": "./package.json"
  },
  "workspaces": [
    "apps/*"
  ],
  "scripts": {
    "typecheck": "vue-tsc --noEmit -p tsconfig.json",
    "lint": "bunx --bun eslint .",
    "lint:fix": "bunx --bun eslint . --fix",
    "test": "vitest run",
    "test:unit": "vitest run --project unit",
    "test:browser": "vitest run --project browser",
    "test:visual": "playwright test",
    "contrast": "bun scripts/contrast.ts",
    "registry:sync": "bun scripts/sync-registry.ts",
    "registry:build": "bun run registry:sync && bunx --bun shadcn-vue build registry.json --output registry/r",
    "llms": "bun scripts/generate-llms.ts",
    "llms:check": "bun scripts/generate-llms.ts --check",
    "pages:build": "bun scripts/build-pages.ts",
    "example:build": "bun run --cwd examples/nuxt-demo build",
    "playground:build": "bun run --cwd apps/playground build",
    "registry:check": "bun scripts/check-registry.ts",
    "prepush": "bun run typecheck && bun run lint && bun run test:unit",
    "release": "bun scripts/release.ts",
    "prepare": "simple-git-hooks || true",
    "check": "bun run typecheck && bun run lint && bun run test && bun run contrast && bun run registry:check && bun run llms:check && bun run docs:typecheck && bun run docs:build && bun run playground:build",
    "docs:prepare": "bun apps/docs/scripts/prepare.ts",
    "docs:dev": "bun run --cwd apps/docs dev",
    "docs:build": "bun run --cwd apps/docs generate",
    "docs:preview": "bun scripts/serve-static.ts apps/docs/.output/public 4173 /elfUI/",
    "test:visual:update": "playwright test --update-snapshots",
    "docs:typecheck": "bun run --cwd apps/docs typecheck"
  },
  "dependencies": {
    "@lucide/vue": "1.79.0",
    "@nuxt/kit": "4.7.0",
    "@vueuse/core": "15.1.0",
    "class-variance-authority": "0.7.1",
    "clsx": "2.1.1",
    "reka-ui": "2.11.0",
    "tailwind-merge": "3.7.1"
  },
  "peerDependencies": {
    "@tailwindcss/vite": "^4.3.0",
    "nuxt": "^4.6.4",
    "tailwindcss": "^4.3.0",
    "typescript": ">=5.0.0 <7.0.0",
    "vue": "^3.5.0"
  },
  "peerDependenciesMeta": {
    "nuxt": {
      "optional": true
    }
  },
  "devDependencies": {
    "@antfu/eslint-config": "10.0.0",
    "@playwright/test": "1.64.0",
    "@tailwindcss/vite": "4.3.5",
    "@types/bun": "1.4.5",
    "@types/node": "22.10.0",
    "@vitejs/plugin-vue": "6.0.11",
    "@vitest/browser": "5.1.1",
    "@vitest/browser-playwright": "5.1.1",
    "@vue/test-utils": "2.6.0",
    "axe-core": "^4.14.1",
    "eslint": "10.15.0",
    "happy-dom": "21.0.4",
    "nuxt": "4.7.0",
    "playwright": "1.64.0",
    "shadcn-vue": "2.9.0",
    "simple-git-hooks": "2.14.0",
    "tailwindcss": "4.3.5",
    "typescript": "5.9.3",
    "vite": "8.3.8",
    "vitest": "5.1.1",
    "vue": "3.5.46",
    "vue-tsc": "3.3.14"
  },
  "engines": {
    "node": ">=22"
  },
  "simple-git-hooks": {
    "pre-push": "bun run prepush"
  },
  "homepage": "https://xouyi.github.io/elfUI/",
  "bugs": {
    "url": "https://github.com/xouyi/elfUI/issues"
  }
}
